{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(jq:*)",
      "Bash(cd:*)",
      "Bash(pwd:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(uname:*)",
      "Bash(which:*)",
      "Bash(type:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git stash list:*)",
      "Bash(git tag:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(node --version:*)",
      "Bash(npm --version:*)",
      "Bash(npx --version:*)",
      "Bash(npm list:*)",
      "Bash(npm ls:*)",
      "Bash(~/.local/bin/sdlc-gh-get-user.sh)",
      "Bash(~/.local/bin/sdlc-gh-search-issues.sh:*)",
      "Bash(~/.local/bin/sdlc-gh-get-review-threads.sh:*)",
      "Bash(~/.local/bin/sdlc-gh-get-pr-comments.sh:*)",
      "Bash(~/.local/bin/sdlc-gh-get-pr-reviews.sh:*)",
      "Bash(~/.local/bin/sdlc-gh-get-pr-commits.sh:*)",
      "Bash(~/.local/bin/sdlc-gh-get-commit-diff.sh:*)",
      "Bash(gh pr view:*)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "frontend-design@claude-plugins-official": true,
    "sdlc-jira-github@guild-ai-skills": true,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "codex@openai-codex": true,
    "design-for-ai@rtd": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "rtd": {
      "source": {
        "source": "github",
        "repo": "ryanthedev/rtd-claude-inn"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "companyAnnouncements": [
    "Hit ‘em with the ol’ Razzle Dazzle"
  ],
  "tui": "fullscreen",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}
